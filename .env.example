# BADO University Edition — Environment Configuration Template
# Copy this file to `.env` and populate values for your Supabase project.
# SECURITY: NEVER put SUPABASE_SERVICE_ROLE_KEY or direct database passwords in
# any frontend `.env` or `VITE_*` variable. Only public client-safe values belong here.

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=

# Supabase Publishable / Anonymous Key (RLS enforced server-side)
VITE_SUPABASE_ANON_KEY=

# Data mode: "auto" (uses Supabase when configured, otherwise clearly labelled Demo Mode),
# "supabase" (requires Supabase env vars), or "demo" (forces simulated local sandbox)
VITE_BADO_DATA_MODE=auto

# Map tile configuration (Phase 3+ — respect provider tile usage policy; never bulk-scrape OSM)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
